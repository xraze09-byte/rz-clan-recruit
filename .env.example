# Postgres (ฐานข้อมูลหลัก: ใบสมัคร + รอบทดสอบ)
# เชื่อม Neon ผ่าน Vercel → Storage → Marketplace จะได้ DATABASE_URL ใส่ให้เองอัตโนมัติ
DATABASE_URL=

# Upstash Redis (ใช้เฉพาะ rate limit และล็อกรหัสผิด) ถ้าเชื่อมผ่าน Vercel Marketplace จะได้ KV_REST_API_URL / KV_REST_API_TOKEN มาอัตโนมัติ
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# รหัสผ่านแอดมิน ต้องยาวอย่างน้อย 16 ตัว (สร้างได้ด้วย: openssl rand -base64 24)
ADMIN_PASSWORD=

# ข้อความสุ่มยาว ๆ ใช้ hash IP
IP_HASH_SALT=

# ไม่บังคับ: Cloudflare Turnstile (Site Key ใส่ใน index.html ตรง TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=
